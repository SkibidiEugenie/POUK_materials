<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pouk_bringup</name>
  <version>1.0.0</version>
  <description>Запуск стенда ПОУК (ЛР3-ЛР4): профили развёртывания, описания запуска, программы самопроверки, зонд часов и проверка дерева координат.</description>
  <maintainer email="shereuzhev@gmail.com">М. А. Шереужев</maintainer>
  <license>MIT</license>

  <exec_depend>pouk_link</exec_depend>
  <exec_depend>pouk_interfaces</exec_depend>
  <exec_depend>pouk_description</exec_depend>
  <exec_depend>pouk_bridge</exec_depend>
  <exec_depend>pouk_coordinator</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
