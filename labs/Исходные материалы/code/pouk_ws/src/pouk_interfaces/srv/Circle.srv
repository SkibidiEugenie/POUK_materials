# Go around a horizontal circle point by point, checking that every point is reached.
# Center and radius are in base_link, meters. n = 0 and laps = 0 mean defaults.
float64 cx
float64 cy
float64 cz
float64 r
uint32 n            # number of points on the circle
uint32 laps         # number of laps
---
bool accepted
string message
