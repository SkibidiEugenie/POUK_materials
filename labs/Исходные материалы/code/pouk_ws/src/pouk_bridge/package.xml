<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pouk_bridge</name>
  <version>1.0.0</version>
  <description>Мост ROS 2 - стенд ПОУК (ЛР3, ЛР4-А): joint_states, команды по именам суставов, режимы, диагностика, исполнитель FollowJointTrajectory. Ядро (соответствие суставов, интерполяция, контракт исполнителя) не зависит от ROS.</description>
  <maintainer email="shereuzhev@gmail.com">М. А. Шереужев</maintainer>
  <license>MIT</license>

  <exec_depend>pouk_link</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
